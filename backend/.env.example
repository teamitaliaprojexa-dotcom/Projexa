# Database
DATABASE_URL=postgresql://user:password@host:5432/projexa

# Server
PORT=3001
NODE_ENV=production
BACKEND_URL=https://www.projexa.it
APP_URL=https://www.projexa.it
# SQL editor (solo Admin, SQL libero su tutti i database): spento sulla VM di produzione,
# da lasciare commentato in locale.
DISABLE_SQL_EDITOR=true

# JWT
JWT_SECRET=your-super-secret-key-change-this-in-production

# Google OAuth (login + integrazione Calendar: stesso client, redirect URI diversi)
# Redirect URI aggiuntivo da autorizzare in Google Cloud Console:
#   {BACKEND_URL}/api/calendar/google/callback
# Scope aggiuntivo richiesto (schermata di consenso OAuth):
#   https://www.googleapis.com/auth/calendar.readonly
GOOGLE_CLIENT_ID=128379880931-guh70j47lsvplo9m1intpj9tt7escdn8.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-from-gcp-console

# Microsoft OAuth (login + integrazione Calendar: stesso client, redirect URI diversi)
# Redirect URI aggiuntivo da autorizzare in Azure (App registration > Authentication):
#   {BACKEND_URL}/api/calendar/outlook/callback
# Permesso API aggiuntivo da concedere (Microsoft Graph, delegato, con admin consent):
#   Calendars.Read  (offline_access è di norma già incluso di default)
MICROSOFT_CLIENT_ID=9f2bbd57-07ad-4368-83ed-14dd373e86e8
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret-from-azure-ad
MICROSOFT_TENANT_ID=1977b365-a1d3-4119-9f29-e676094eb845

# Trascrizione riunioni: servizio "Projexa Whisper" (cartella whisper-service; sulla VM
# servizi systemd projexa-whisper@800N, in locale whisper-service/avvia_locale.bat).
# Stessa chiave impostata anche sul servizio Whisper. WHISPER_URLS: più servizi separati da virgola.
WHISPER_URL=http://127.0.0.1:8001
WHISPER_API_KEY=una-chiave-casuale-lunga
# "modalità Trascrizione" = Background-Veloce: whisper.cpp sulla VM (deploy/oracle/setup-whisper-cpp.sh).
# Facoltativa: se manca, chi ha scelto Background-Veloce usa i servizi WHISPER_URLS.
# WHISPER_CPP_URL=http://127.0.0.1:8101

# Diarizzazione (fase 1): le righe «Partecipanti» diventano «Partecipante 1, 2…» a fine riunione.
# Servizio diarizzazione-service (sulla VM deploy/oracle/setup-diarizzazione.sh, in locale
# diarizzazione-service/avvia_locale.bat). Vuota = diarizzazione spenta. Serve la tabella
# Supporto/CreaDB/rec_meeting_voci.sql.
# DIARIZZAZIONE_URL=http://127.0.0.1:8105
# DIARIZZAZIONE_SOGLIA=0.65  (somiglianza minima tra due voci per considerarle la stessa persona:
#                             più alta = più partecipanti distinti, più bassa = meno)

# Anonymization Layer (backend/config/pii.js): i dati personali diventano segnaposto prima di
# ogni invio alle AI esterne (Claude, ChatGPT, Gemini, Mistral) e tornano veri nella risposta.
# Attivo di default con nomi noti + regole; con PII_URL anche Presidio + spaCy it_core_news_lg
# (deploy/oracle/setup-pii.sh scrive PII_URL nel .env della VM). In locale si può lasciare vuota.
# PII_URL=http://127.0.0.1:8104
# PII_MASCHERAMENTO=0                 (spegne l'anonimizzazione: SCONSIGLIATO)
# PII_SE_NON_DISPONIBILE=blocca       (servizio Presidio giù: non inviare; predefinito "regole")
# PII_ENTITA_NER=PERSON               (es. PERSON,ORGANIZATION,LOCATION)
# PII_SOGLIA=0.5
# PII_CONSENTITI=NomeProdotto,AltroNome   (mai mascherati, oltre a Projexa, Jira, Qlik...)

# Schedulatore dei job (tabella job_schedules, backend/jobs/scheduler.js).
# Metterlo a true SOLO sul server: il backend locale usa lo stesso database e
# lancerebbe gli stessi job una seconda volta.
JOB_SCHEDULER_ENABLED=false

# Log accessi e variazioni su Oracle Autonomous Database (backend/jobs/auditShipper.js,
# script Supporto/CreaDB/audit_log.sql e oracle_audit.sql).
# AUDIT_ORACLE_ENABLED=true SOLO sul server, come JOB_SCHEDULER_ENABLED.
# ORACLE_AUDIT_CONNECT = stringa di connessione TLS copiata dalla console Oracle
# (Database connection -> TLS, servizio "_low"), tutta su una riga.
AUDIT_ORACLE_ENABLED=false
ORACLE_AUDIT_USER=projexa_log
ORACLE_AUDIT_PASSWORD=
ORACLE_AUDIT_CONNECT=

# Pagina Monitor (Monitor VM, Schedulazioni, Log) in SOLA LETTURA per questi utenti
# (email di login separate da virgola): vedono tutto e possono solo aggiornare.
MONITOR_LETTURA_EMAILS=

# whisper.cpp dedicato all'Assistente PM. Sulla VM: http://127.0.0.1:8102 (servizio
# projexa-whisper-assistente, deploy/oracle/setup-whisper-assistente.sh, la imposta da solo).
# In locale: tunnel SSH, porta 18101 (whisper.cpp della VM).
# ASSISTENTE_PM_WHISPER_CPP_URL=http://127.0.0.1:18101

# Assistente PM (Gemini Live): modello e modelli di riserva (quota esaurita / sovraccarico)
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_LIVE_FALLBACK_MODEL=gemini-3.1-flash-live-preview

